# Production Environment Configuration for Docker
# This file is used when running with docker-compose

# Application Settings
NODE_ENV=production
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Database Configuration
DATABASE_URL=postgresql://kolam_user:kolam_password@postgres:5432/kolam_db
DATABASE_URL_TEST=postgresql://kolam_user:kolam_password@postgres:5432/kolam_test_db

# OpenSearch Configuration
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Redis Configuration
REDIS_URL=redis://redis:6379

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=kolam-secret-key-change-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Models - Add your API keys here
GEMINI_API_KEY=your-gemini-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# File Storage
UPLOAD_DIR=/app/uploads
MODELS_DIR=/app/models
GENERATED_IMAGES_DIR=/app/generated_images

# Logging
LOG_LEVEL=INFO
LOG_DIR=/app/logs